# Copy this to .env (gitignored) before running `docker compose up`.
# Every value below is read directly by application-prod.yaml — cross-checked
# against that file, not guessed. application-prod.yaml has NO fallback
# defaults for DB_HOST/DB_USER/DB_PASSWORD/JWT_SECRET on purpose (fails fast
# instead of silently running with a checked-in credential) — the app WILL
# NOT boot without these actually set.
#
# The values below are dev-only examples for the local docker-compose stack.
# Rotate/replace every secret (DB_PASSWORD, JWT_SECRET) before using this
# anywhere beyond your own machine — same convention as application-local.yaml
# and application-prod.yaml already use.
#
# Kubernetes mapping, when you get there: DB_HOST/DB_PORT/DB_NAME/
# JWT_EXPIRATION_MS/OTP_EXPIRATION_MS/SPRING_PROFILES_ACTIVE are plain config
# -> ConfigMap. DB_USER/DB_PASSWORD/JWT_SECRET are secrets -> Secret.

# Which Spring profile to load. application-prod.yaml (not -local) is what
# this whole docker-compose stack is built around.
SPRING_PROFILES_ACTIVE=prod

# Postgres connection — also used directly by the postgres service below to
# provision the same database/user/password on first startup, so there's one
# source of truth instead of two copies that can drift.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=catalyst_users
DB_USER=farmiq
DB_PASSWORD=dev-only-change-me

# JWT signing key (HS256, jjwt) — must be base64, and decode to >= 256 bits
# (32 bytes) or JwtService refuses to start. Generate your own with:
#   openssl rand -base64 32
JWT_SECRET=alhA+xovdoeJ1FRphxsm8ydYsgRmatLUfM6+qUu055E=
JWT_EXPIRATION_MS=3600000
OTP_EXPIRATION_MS=600000

# Dead config, included anyway so it doesn't look like an oversight: this key
# does not configure a real gRPC port (see application-prod.yaml's inline
# comment) — gRPC actually rides server.port (8080) via Tomcat servlet mode.
# Confirmed with grpcurl; nothing ever listens on this port.
GRPC_PORT=3030
